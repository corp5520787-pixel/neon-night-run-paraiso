# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The public URL where this app is hosted (e.g. http://localhost:3000 or production domain)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MERCADO PAGO: Credenciales para Checkout Pro (Modo Sandbox / Pruebas)
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_WEBHOOK_SECRET=""

# SUPABASE (Opcional - La aplicación funciona en modo demostración local si no se configuran)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# RESEND: Para envío de correos transaccionales con QR y folios (Opcional)
RESEND_API_KEY="re_00000000_000000000000000000000000"
EMAIL_FROM="Neon Night Run Paraíso <contacto@neonnightrunparaiso.mx>"

# MODO DEMO: Activo por defecto en desarrollo local
NEXT_PUBLIC_DEMO_MODE="true"

# ADMINISTRACIÓN: Configuración de acceso para el panel administrativo en producción
ADMIN_EMAIL="admin@neonnightrun.com"
ADMIN_PASSWORD="admin2026"
STAFF_EMAIL="kits@neonnightrun.com"
STAFF_PASSWORD="kits2026"

# OPCIONAL: Para configurar autocompletado de prueba en el login demo
NEXT_PUBLIC_ADMIN_EMAIL="admin@neonnightrun.com"
NEXT_PUBLIC_STAFF_EMAIL="kits@neonnightrun.com"
NEXT_PUBLIC_ADMIN_PASSWORD="admin2026"

# FIREBASE CONFIGURATION (Requerido para la opción de base de datos en producción o hosting propio)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID=""


